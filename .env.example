# NaIA live-provider validation environment
# NEVER commit real secret values. Copy this file locally to .env or inject via your runtime/secret manager.

# Model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Google Workspace / Photos OAuth access tokens
# Prefer separate tokens while validating least-privilege scopes.
GMAIL_ACCESS_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_PHOTOS_ACCESS_TOKEN=

# Slack
SLACK_ACCESS_TOKEN=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Needed when webhook verification endpoint is wired.
WHATSAPP_VERIFY_TOKEN=

# Belvo Open Finance
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_LINK_ID=
BELVO_API_BASE_URL=https://sandbox.belvo.com
